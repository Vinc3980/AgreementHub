# Copy to .env and adjust. Never commit real .env files.

# PostgreSQL connection (dev database)
DATABASE_URL=postgres://agreementhub:agreementhub@127.0.0.1:5432/agreementhub
# Test database used by the automated test suite
TEST_DATABASE_URL=postgres://agreementhub:agreementhub@127.0.0.1:5432/agreementhub_test

# HTTP
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Browser/web origin used for user-facing links (verification, reset, invitations, QR targets).
# Must be the web app origin (Next.js dev port 3001), not the API port.
WEB_BASE_URL=http://localhost:3001
# Browser origin of the web app (allowed CORS/CSRF origin)
WEB_ORIGIN=http://localhost:3001
# Legacy/public API base (kept for compatibility; user-facing links use WEB_BASE_URL)
PUBLIC_BASE_URL=http://localhost:3000
# Extra comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=
# Trust X-Forwarded-* headers (only when behind a reverse proxy)
TRUST_PROXY=false

# Session
SESSION_TTL_HOURS=168
SESSION_COOKIE_NAME=ah_session

# Agreement public ID prefix (AGR-GH-2026-000001 => AGR-GH)
AGREEMENT_ID_PREFIX=AGR-GH

# Rate limiting (requests per window per IP)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Email delivery (queued in the email_outbox table and sent by a worker).
# console = log messages (development), memory = capture for tests,
# smtp = real SMTP delivery, disabled = drop.
EMAIL_TRANSPORT=console
EMAIL_FROM=AgreementHub <no-reply@agreementhub.local>
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_SMTP_SECURE=false
EMAIL_RETRY_MAX=5
EMAIL_RETENTION_DAYS=30

# Background scheduler: expiry transitions/reminders, signature reminders,
# outbox delivery and retention. 0 disables the timer (tests call sweeps
# directly). Interval is milliseconds.
SCHEDULER_INTERVAL_MS=300000
REMINDER_SIGNATURE_INTERVAL_DAYS=3
REMINDER_SIGNATURE_MAX=5
EXPIRY_WARN_DAYS=30,7,1

# Comma-separated emails automatically granted platform-admin privileges at
# registration. Prefer setting users.is_platform_admin directly in production.
PLATFORM_ADMIN_EMAILS=

# AI Agreement Assistant (server-side only; keys never reach the web app)
# rules  = deterministic offline assistant, no key needed (default)
# openai = OpenAI-compatible chat completions (requires OPENAI_API_KEY)
AI_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Server-side storage root: document-pipeline PDFs under documents/,
# future uploads under attachments/ (never exposed via the API)
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=26214400
